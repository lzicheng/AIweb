server {
  listen 80;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;

  set $ops_assistant_upstream "${VITE_OPS_ASSISTANT_PROXY_TARGET}";
  set $step_status_upstream "${VITE_STEP_STATUS_PROXY_TARGET}";
  set $alert_converger_upstream "${VITE_ALERT_CONVERGER_PROXY_TARGET}";
  set $digital_human_upstream "${VITE_DIGITAL_HUMAN_PROXY_TARGET}";

  root /usr/share/nginx/html;
  index index.html;

  location = /config.js {
    add_header Cache-Control "no-store";
    try_files /config.js =404;
  }

  location /config/ {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  location /teams {
    proxy_pass $ops_assistant_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/step-status {
    proxy_pass $step_status_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/public {
    proxy_pass $alert_converger_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/v1 {
    proxy_pass $digital_human_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health {
    proxy_pass $digital_human_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
